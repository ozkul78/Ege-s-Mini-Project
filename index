<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>EGE ÖZKUL SEA ANIMALS QUESTION WHEEL</title>
<title>This Mini Project developed by Lily Teacher</title>
<style>
* { box-sizing: border-box; }

body {
  margin: 0;
  padding: 20px 12px;
  text-align: center;
  font-family: Arial, sans-serif;
  color: #073b70;
  background: linear-gradient(#eafaff, #bce8ff);
}

header {
  max-width: 850px;
  margin: auto;
  padding: 22px 12px;
  color: white;
  background: #075b96;
  border: 4px solid white;
  border-radius: 22px;
  box-shadow: 0 6px 0 #7bc9ec;
}

h1 {
  margin: 8px 0;
  font-size: clamp(23px, 5vw, 38px);
  line-height: 1.2;
}

main {
  max-width: 850px;
  margin: 24px auto;
}

.wheels {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
}

.panel {
  padding: 22px 12px;
  min-height: 230px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background: white;
  border: 4px solid #168bd2;
  border-radius: 22px;
  box-shadow: 0 6px 0 #8bd6f4;
}

.question {
  border-color: #f0b82e;
  background: #fffdf3;
  box-shadow: 0 6px 0 #f8dc86;
}

.label {
  font-size: 15px;
  font-weight: bold;
  letter-spacing: 2px;
}

.emoji {
  margin: 12px 0;
  font-size: clamp(60px, 12vw, 95px);
}

.result {
  font-size: clamp(19px, 3vw, 25px);
  font-weight: bold;
  line-height: 1.35;
}

button {
  margin-top: 28px;
  padding: 17px 25px;
  border: none;
  border-radius: 50px;
  background: #ffd166;
  color: #073b70;
  font-size: 19px;
  font-weight: bold;
  cursor: pointer;
  box-shadow: 0 5px 0 #d49b20;
}

button:active {
  transform: translateY(3px);
  box-shadow: 0 2px 0 #d49b20;
}

.answer {
  margin-top: 24px;
  padding: 18px;
  background: white;
  border: 2px solid #a6dff4;
  border-radius: 18px;
  line-height: 1.5;
}

.answer h2 {
  margin-top: 0;
  color: #0878b7;
  font-size: 20px;
}

#example {
  font-size: 19px;
}

footer {
  margin-top: 22px;
  font-size: 14px;
}

@media (max-width: 520px) {
  .wheels { grid-template-columns: 1fr; }
  .panel { min-height: 190px; }
}
</style>
</head>

<body>

<header>
  <div style="font-size:30px">🐬 🌊 🐠 🐙 🌊</div>
  <h1>EGE ÖZKUL's Mini Project<br>SEA ANIMALS QUESTION WHEEL</h1>
<h3>❤️ Made for Ege's English Project ❤️ This Mini Project developed by Lily Teacher ❤️</h3>
  <p>Spin, ask and answer in English!</p>
</header>

<main>
  <div class="wheels">

    <section class="panel">
      <div class="label">🐚 SEA ANIMAL</div>
      <div class="emoji" id="animalEmoji">🐬</div>
      <div class="result" id="animalName">DOLPHIN</div>
    </section>

    <section class="panel question">
      <div class="label">❓ YOUR QUESTION</div>
      <div class="emoji">💭</div>
      <div class="result" id="questionText">
        WHAT DOES IT EAT?
      </div>
    </section>

  </div>

  <button id="spinButton" type="button">
    🌊 SPIN THE WHEEL! 🌊
  </button>

  <p>Spin the wheel and answer the question in English!</p>

  <section class="answer">
    <h2>💡 EXAMPLE ANSWER</h2>
    <p id="example">A dolphin eats fish and squid.</p>
  </section>
</main>

<footer>
 ❤️ Made for Ege's English Project ❤️
This Mini Project developed by Lily Teacher ❤️
</footer>

<script>
const animals = [
  {
    name: "DOLPHIN",
    emoji: "🐬",
    answers: [
      "A dolphin eats fish and squid.",
      "A dolphin lives in oceans and seas.",
      "It has a smooth body and a long nose.",
      "Yes, dolphins play with each other.",
      "Dolphins make sounds, but they cannot talk like people.",
      "Yes, I do. Dolphins are clever and friendly."
    ]
  },
  {
    name: "SHARK",
    emoji: "🦈",
    answers: [
      "A shark eats fish and other sea animals.",
      "A shark lives in the sea or ocean.",
      "It has fins, sharp teeth and a strong tail.",
      "Some sharks play, but they mostly look for food.",
      "No, it cannot talk.",
      "Yes, I do. Sharks are fascinating."
    ]
  },
  {
    name: "WHALE",
    emoji: "🐳",
    answers: [
      "Some whales eat krill. Others eat fish.",
      "A whale lives in the ocean.",
      "It has a huge body and a tail.",
      "Whales can play and jump out of the water.",
      "Whales sing and make sounds, but they cannot talk like people.",
      "Yes, I do. Whales are amazing."
    ]
  },
  {
    name: "CROCODILE",
    emoji: "🐊",
    answers: [
      "A crocodile eats fish, birds and other animals.",
      "A crocodile lives in rivers, lakes and wetlands.",
      "It has a long body, short legs and strong jaws.",
      "Young crocodiles sometimes play.",
      "No, it cannot talk.",
      "Yes, I do. Crocodiles are interesting."
    ]
  },
  {
    name: "JELLYFISH",
    emoji: "🪼",
    answers: [
      "A jellyfish eats tiny sea animals and plankton.",
      "A jellyfish lives in the sea or ocean.",
      "It has a soft body and tentacles.",
      "It does not play like people or dolphins.",
      "No, it cannot talk.",
      "Yes, I do. Jellyfish look beautiful."
    ]
  },
  {
    name: "OCTOPUS",
    emoji: "🐙",
    answers: [
      "An octopus eats crabs, shrimp and small sea animals.",
      "An octopus lives in the ocean, often near the sea floor.",
      "It has a soft body and eight arms.",
      "Yes, an octopus can play with objects.",
      "No, it cannot talk, but it can change colour.",
      "Yes, I do. Octopuses are clever."
    ]
  }
];

const questions = [
  "WHAT DOES IT EAT?",
  "WHERE DOES IT LIVE?",
  "WHAT DOES IT LOOK LIKE?",
  "DOES IT PLAY?",
  "CAN IT TALK?",
  "DO YOU LIKE IT?"
];

let previousAnimal = -1;
let previousQuestion = -1;
let spinning = false;

function randomIndex(length, previous) {
  let index;
  do {
    index = Math.floor(Math.random() * length);
  } while (length > 1 && index === previous);
  return index;
}

function showResult(animalIndex, questionIndex) {
  const animal = animals[animalIndex];

  document.getElementById("animalEmoji").textContent =
    animal.emoji;

  document.getElementById("animalName").textContent =
    animal.name;

  document.getElementById("questionText").textContent =
    questions[questionIndex];

  document.getElementById("example").textContent =
    animal.answers[questionIndex];
}

document.getElementById("spinButton").addEventListener(
  "click",
  function () {
    if (spinning) return;

    spinning = true;
    this.disabled = true;
    this.textContent = "🌊 SPINNING... 🌊";

    const finalAnimal = randomIndex(
      animals.length, previousAnimal
    );

    const finalQuestion = randomIndex(
      questions.length, previousQuestion
    );

    let count = 0;

    const timer = setInterval(function () {
      const randomAnimal = Math.floor(
        Math.random() * animals.length
      );

      const randomQuestion = Math.floor(
        Math.random() * questions.length
      );

      showResult(randomAnimal, randomQuestion);
      count++;

      if (count >= 15) {
        clearInterval(timer);

        previousAnimal = finalAnimal;
        previousQuestion = finalQuestion;

        showResult(finalAnimal, finalQuestion);

        spinning = false;

        const button = document.getElementById("spinButton");
        button.disabled = false;
        button.textContent = "🌊 SPIN AGAIN! 🌊";
      }
    }, 100);
  }
);
</script>

</body>
</html>
